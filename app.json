{
  "expo": {
    "name": "BachelorProj",
    "slug": "BachelorProj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.noe.sorensen.BachelorProj"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow this app to add events to your calendar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow this app to use your location while you use the app to share your position for live events.",
          "locationAlwaysAndWhenInUsePermission": "Allow this app to access your location in the background so live event sharing stays active until you stop it or the event ends.",
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bcf7f63c-f226-4787-8255-e4a70018f1f4"
      }
    }
  }
}
